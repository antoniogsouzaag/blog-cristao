# ─── Banco de Dados ──────────────────────────────────────────────────────────
# Use SUPABASE_DB_URL quando a senha tiver caracteres especiais
# O app faz URL-encode automático — passe a URL crua sem modificar
SUPABASE_DB_URL=postgresql://user:password@host:6543/postgres

# Alternativa: DATABASE_URL com senha já encodada (sem encode automático)
# DATABASE_URL=postgresql://user:password%40encoded@host:5432/dbname

# ─── Servidor ────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production
LOG_LEVEL=info
