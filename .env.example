# Conexão com o banco de dados PostgreSQL
# Use DATABASE_URL para Neon, Supabase direto (connection string padrão)
# Use SUPABASE_DB_URL se a senha tiver caracteres especiais (o app faz encode automático)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Porta do servidor (padrão: 3001)
PORT=3001
