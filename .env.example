# ─── Banco de Dados ──────────────────────────────────────────────────────────
# Use SUPABASE_DB_URL com a URL exatamente como o painel do Supabase mostra.
# O app aceita tanto senhas URL-encoded (%40, %23 etc.) quanto senhas cruas.
# Cole a "Connection string" do Supabase → Settings → Database → Connection string (URI).
SUPABASE_DB_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Alternativa: DATABASE_URL padrão PostgreSQL (sem suporte a SSL automático)
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ─── Servidor ────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production
LOG_LEVEL=info
